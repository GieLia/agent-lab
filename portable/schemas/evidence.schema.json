{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence.schema.json",
  "title": "Evidence",
  "type": "object",
  "required": [
    "evidence_id",
    "claim_id",
    "source_id",
    "relationship"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "relationship": {
      "type": "string",
      "enum": [
        "supports",
        "contradicts",
        "context",
        "unclear"
      ]
    },
    "excerpt": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "strength": {
      "type": "string",
      "enum": [
        "weak",
        "moderate",
        "strong"
      ],
      "default": "moderate"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-version": 1
}
