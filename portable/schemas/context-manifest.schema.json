{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-manifest.schema.json",
  "title": "ContextManifest",
  "type": "object",
  "required": [
    "manifest_id",
    "version",
    "status",
    "role_profile",
    "skills",
    "tool_profile",
    "schemas",
    "context_budget"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "experimental",
        "disabled"
      ]
    },
    "role_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "tool_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "schemas": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*\\.schema\\.json$"
      }
    },
    "context_budget": {
      "type": "object",
      "required": [
        "max_files",
        "max_bytes"
      ],
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-version": 1
}
