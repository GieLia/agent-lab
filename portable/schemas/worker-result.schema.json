{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "worker-result.schema.json",
  "title": "WorkerResult",
  "type": "object",
  "required": [
    "worker_id",
    "role",
    "status",
    "claims",
    "sources",
    "evidence"
  ],
  "properties": {
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "research-lead",
        "researcher",
        "critic",
        "evidence-verifier",
        "synthesizer"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "account": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "claim.schema.json"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "source.schema.json"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "x-version": 1
}
