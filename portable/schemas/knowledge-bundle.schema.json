{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-bundle.schema.json",
  "title": "KnowledgeBundle",
  "type": "object",
  "required": [
    "bundle_id",
    "created_at",
    "ledger_entries",
    "sources",
    "evidence"
  ],
  "properties": {
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "ledger_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "ledger-entry.schema.json"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "source.schema.json"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "x-version": 1
}
