{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "title": "Claim",
  "type": "object",
  "required": [
    "claim_id",
    "text",
    "claim_type"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "fact",
        "interpretation",
        "assumption",
        "speculation",
        "recommendation"
      ]
    },
    "importance": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "partially_verified",
        "verified",
        "contradicted",
        "disputed"
      ],
      "default": "unverified"
    }
  },
  "additionalProperties": false,
  "x-version": 1
}
