{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledger-entry.schema.json",
  "title": "LedgerEntry",
  "type": "object",
  "required": [
    "entry_id",
    "created_at",
    "claim"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "claim": {
      "$ref": "claim.schema.json"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "disputed",
        "retracted"
      ],
      "default": "active"
    }
  },
  "additionalProperties": false
}
