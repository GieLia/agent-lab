{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledger-entry.schema.json",
  "title": "LedgerEntry",
  "type": "object",
  "required": [
    "entry_id",
    "created_at",
    "claim",
    "evidence_ids"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "claim": {
      "$ref": "claim.schema.json"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "description": "Knowledge-record lifecycle state. This is independent from claim.verification_status.",
      "enum": [
        "active",
        "superseded",
        "under_review",
        "retracted"
      ],
      "default": "active"
    },
    "retraction": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "authorized_by": {
          "type": "string",
          "minLength": 1
        },
        "authorization_basis": {
          "type": "string",
          "minLength": 1
        },
        "authorized_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reason",
        "authorized_by",
        "authorization_basis",
        "authorized_at"
      ],
      "additionalProperties": false
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional forward pointer to the durable entry that superseded this record."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "retracted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "retraction"
        ],
        "properties": {
          "retraction": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "retraction": {
            "type": "object"
          }
        },
        "required": [
          "retraction"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "retracted"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  ],
  "x-version": 1
}
