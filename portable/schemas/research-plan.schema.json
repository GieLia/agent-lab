{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-plan.schema.json",
  "title": "ResearchPlan",
  "type": "object",
  "required": [
    "objective",
    "research_questions",
    "workstreams"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "research_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "workstream_id",
          "objective"
        ],
        "properties": {
          "workstream_id": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
